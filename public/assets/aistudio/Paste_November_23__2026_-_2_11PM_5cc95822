        >
          <Boxes className="w-3.5 h-3.5" />
          <span>Stock</span>
        </button>

        <button
          onClick={() => setActiveTabState('movements')}
          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold transition whitespace-nowrap ${
            activeTab === 'movements'
