                  </button>
                )}
              </div>

              {/* Matching Results Dropdown — shown strictly when user types in search */}
              {purchaseProductSearch.trim() && (
                <div className="bg-slate-950 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
